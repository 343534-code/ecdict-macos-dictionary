#!/bin/bash

# DictionaryServices and the three-finger Lookup panel keep dictionary bundles
# open in long-lived processes. Restart both clients after replacing the bundle
# so an updated entry is not rendered from the previous in-memory version.

/usr/bin/touch /Library/Dictionaries >/dev/null 2>&1 || true

console_user="$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)"
if [[ -n "$console_user" && "$console_user" != "root" ]]; then
    /usr/bin/killall -9 -u "$console_user" LookupViewService >/dev/null 2>&1 || true
    /usr/bin/killall -9 -u "$console_user" com.apple.DictionaryServiceHelper >/dev/null 2>&1 || true
    /usr/bin/killall -u "$console_user" Dictionary >/dev/null 2>&1 || true
fi

exit 0
